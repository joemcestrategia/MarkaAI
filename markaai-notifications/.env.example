# ============================================================
#  MarkaAI — Credenciais de Notificações
#  PREENCHA ESTES VALORES ANTES DE FAZER O DEPLOY
# ============================================================

# ─── WHATSAPP (Meta Cloud API) ───────────────────────────────
# Onde encontrar: developers.facebook.com → Seu App → WhatsApp → API Setup
WHATSAPP_TOKEN=SEU_TOKEN_PERMANENTE_AQUI
WHATSAPP_PHONE_ID=SEU_PHONE_NUMBER_ID_AQUI
WHATSAPP_BUSINESS_ID=SEU_WABA_ID_AQUI

# ─── EMAIL (Resend) ───────────────────────────────────────────
# Onde encontrar: resend.com → API Keys → Create API Key
RESEND_API_KEY=re_SUA_API_KEY_AQUI
EMAIL_FROM=noreply@markaai.com.br

# ============================================================
#  Como configurar no Firebase:
#
#  firebase functions:secrets:set WHATSAPP_TOKEN
#  firebase functions:secrets:set WHATSAPP_PHONE_ID
#  firebase functions:secrets:set WHATSAPP_BUSINESS_ID
#  firebase functions:secrets:set RESEND_API_KEY
#  firebase functions:secrets:set EMAIL_FROM
# ============================================================
