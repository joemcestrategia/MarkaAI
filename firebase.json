{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "wismart-118c3",
          "appId": "1:170942564821:android:2635798cc73d6202cfd55c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "wismart-118c3",
          "configurations": {
            "android": "1:170942564821:android:2635798cc73d6202cfd55c",
            "ios": "1:170942564821:ios:4c340bd37f25ad5dcfd55c",
            "web": "1:170942564821:web:a326f050b2a75ebacfd55c"
          }
        }
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/login",
        "destination": "/index.html"
      },
      {
        "source": "/register",
        "destination": "/index.html"
      },
      {
        "source": "/home",
        "destination": "/index.html"
      },
      {
        "source": "/business",
        "destination": "/index.html"
      },
      {
        "source": "/client",
        "destination": "/index.html"
      },
      {
        "source": "/admin",
        "destination": "/index.html"
      },
      {
        "source": "/settings",
        "destination": "/index.html"
      },
      {
        "source": "/profile",
        "destination": "/index.html"
      },
      {
        "source": "/checkout",
        "destination": "/index.html"
      },
      {
        "source": "/payment",
        "destination": "/index.html"
      },
      {
        "source": "/success",
        "destination": "/index.html"
      },
      {
        "source": "/error",
        "destination": "/index.html"
      },
      {
        "source": "/subscription_plans",
        "destination": "/index.html"
      },
      {
        "source": "/inventory",
        "destination": "/index.html"
      },
      {
        "source": "/admin/plans",
        "destination": "/index.html"
      },
      {
        "source": "/:slug",
        "function": {
          "functionId": "publicShopPreview",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "platform": "gcfv2",
      "ignore": [
        "node_modules",
        ".git"
      ],
      "predeploy": []
    }
  ]
}