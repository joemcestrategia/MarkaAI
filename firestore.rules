rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPERS — Autenticação e Claims
    // =========================================================================

    /// Verifica se o usuário está autenticado.
    function isSignedIn() {
      return request.auth != null;
    }

    /// Retorna o shopId do usuário, priorizando custom claims para evitar
    /// leituras extras no Firestore (e possíveis loops de permissão).
    /// Fallback via documento /users/{uid} para compatibilidade durante
    /// o período em que o token ainda não foi atualizado pós-cadastro.
    function authShopId() {
      return isSignedIn()
        ? (request.auth.token.get('shopId', null) != null
            ? request.auth.token.shopId
            : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('shopId', null)
                : null))
        : null;
    }

    /// Retorna o role do usuário (dono | receptionist | employee | admin).
    /// Mesma estratégia: claim primeiro, Firestore como fallback.
    function authRole() {
      return isSignedIn()
        ? (request.auth.token.get('role', null) != null
            ? request.auth.token.role
            : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tipo', null)
                : null))
        : null;
    }

    // =========================================================================
    // HELPERS — Verificações de Papel e Pertencimento
    // =========================================================================

    /// Superadmin global da plataforma (MarkaAI).
    function isAdmin() {
      return isSignedIn() && authRole() == 'admin';
    }

    /// Proprietário do shop informado.
    function isDono(shopId) {
      return isSignedIn() && authShopId() == shopId && authRole() == 'dono';
    }

    /// Qualquer membro autenticado pertencente ao shop (dono ou funcionário).
    function isShopMember(shopId) {
      return isSignedIn() && (authShopId() == shopId || isAdmin());
    }

    /// Dono ou recepcionista do shop.
    function isShopManager(shopId) {
      return isShopMember(shopId) && (authRole() == 'dono' || authRole() == 'receptionist');
    }

    /// Verifica pertencimento usando o campo shopId dentro de um documento.
    /// Usado em coleções raíz onde o shopId está no campo do documento.
    function belongsToMyShop(data) {
      return isSignedIn() && (data.shopId == authShopId() || isAdmin());
    }

    /// Garante que o campo shopId não muda numa operação de update.
    function shopIdUnchanged() {
      return request.resource.data.shopId == resource.data.shopId;
    }

    // =========================================================================
    // COLEÇÃO: users
    // Perfis globais dos usuários. Cada usuário gerencia apenas o próprio doc.
    // =========================================================================
    match /users/{uid} {
      allow get:    if isSignedIn();
      allow list:   if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;

      // Subcoleções do usuário
      match /favorites/{shopId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
      match /saved_cards/{cardId} {
        allow get, list, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // =========================================================================
    // COLEÇÃO: shops + subcoleções
    // Documento raíz do tenant. Subcoleções herdando o contexto do shopId.
    // =========================================================================
    match /shops/{shopId} {
      allow get:    if true;   // Necessário para busca pública por slug/cidade
      allow list:   if true;   // Permitir que clientes busquem lojas
      allow create: if isSignedIn();
      allow update: if isDono(shopId) || isAdmin() || 
                    (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcm_tokens', 'fcm_updated_at']));
      allow delete: if false;  // Exclusão somente via Cloud Function

      // --- Clientes do shop ---
      match /clients/{clientId} {
        allow get:    if true;   // Necessário para lookup público no agendamento
        allow list:   if isShopMember(shopId);
        allow create: if isSignedIn();
        allow update: if isShopMember(shopId);
        allow delete: if isDono(shopId) || isAdmin();
      }

      // --- Cupons ---
      match /coupons/{couponId} {
        allow get:    if true;   // Necessário para validação no checkout
        allow list:   if isShopMember(shopId);
        allow write:  if isShopManager(shopId) || isAdmin();
      }

      // --- Resumo de clientes (gravado por Cloud Functions) ---
      match /clientsSummary/{clientId} {
        allow read:   if isShopMember(shopId);
        allow write:  if false; // Apenas Cloud Functions via Admin SDK
      }

      // --- Estatísticas (gravado por Cloud Functions) ---
      match /stats/{statsId} {
        allow read:   if isShopMember(shopId);
        allow write:  if false; // Apenas Cloud Functions via Admin SDK
      }

      // --- Metas Financeiras ---
      match /financial_goals/{goalId} {
        allow read:   if isShopMember(shopId);
        allow write:  if isShopManager(shopId) || isAdmin();
      }

      // --- Histórico de ajustes de preço ---
      match /price_adjustment_history/{adjId} {
        allow read:   if isShopMember(shopId);
        allow write:  if isDono(shopId) || isAdmin();
      }
    }

    // =========================================================================
    // COLEÇÕES RAÍZ — Multi-tenant via campo shopId no documento
    // Padrão: get valida resource.data; list exige membro do shop (via claim).
    // =========================================================================

    // --- Serviços ---
    match /services/{svcId} {
      allow get:    if true;
      allow list:   if isSignedIn();
      allow create: if belongsToMyShop(request.resource.data);
      allow update: if belongsToMyShop(resource.data) && shopIdUnchanged();
      allow delete: if belongsToMyShop(resource.data) && (authRole() == 'dono' || isAdmin());
    }

    // --- Funcionários ---
    match /employees/{empId} {
      allow get:    if true;
      allow list:   if isSignedIn();
      allow create: if belongsToMyShop(request.resource.data);
      allow update: if belongsToMyShop(resource.data) && shopIdUnchanged();
      allow delete: if belongsToMyShop(resource.data) && (authRole() == 'dono' || isAdmin());
    }

    // --- Agendamentos ---
    match /appointments/{appId} {
      allow get:    if true;   // Necessário para confirmação pública de agendamento
      allow list:   if isSignedIn();
      allow create: if isSignedIn(); // Clientes não autenticados usam Cloud Function
      allow update: if belongsToMyShop(resource.data) && shopIdUnchanged();
      allow delete: if belongsToMyShop(resource.data) && (authRole() == 'dono' || isAdmin());
    }

    // --- Transações Financeiras (dado sensível) ---
    match /financial_transactions/{txId} {
      allow get:    if belongsToMyShop(resource.data);
      allow list:   if (isSignedIn() && authShopId() != null && authRole() == 'dono') || isAdmin();
      allow create: if belongsToMyShop(request.resource.data);
      allow update: if belongsToMyShop(resource.data) && shopIdUnchanged();
      allow delete: if isAdmin(); // Nunca deletar diretamente — apenas admin
    }

    // --- Produtos ---
    match /products/{prodId} {
      allow get:    if true;
      allow list:   if isSignedIn();
      allow create: if belongsToMyShop(request.resource.data);
      allow update: if belongsToMyShop(resource.data) && shopIdUnchanged();
      allow delete: if belongsToMyShop(resource.data) && (authRole() == 'dono' || isAdmin());
    }

    // --- Vendas ---
    match /sales/{saleId} {
      allow get:    if belongsToMyShop(resource.data);
      allow list:   if isSignedIn() && authShopId() != null;
      allow create: if belongsToMyShop(request.resource.data);
      allow update: if belongsToMyShop(resource.data) && shopIdUnchanged();
      allow delete: if isAdmin();
    }

    // --- Movimentações de Estoque ---
    match /stock_movements/{mvId} {
      allow get:    if belongsToMyShop(resource.data);
      allow list:   if isSignedIn() && authShopId() != null;
      allow create: if belongsToMyShop(request.resource.data);
      allow update: if false; // Movimentações são imutáveis por design
      allow delete: if isAdmin();
    }

    // --- Inventário ---
    match /inventory/{invId} {
      allow get:    if belongsToMyShop(resource.data);
      allow list:   if isSignedIn() && authShopId() != null;
      allow create: if belongsToMyShop(request.resource.data);
      allow update: if belongsToMyShop(resource.data) && shopIdUnchanged();
      allow delete: if isDono(authShopId()) || isAdmin();
    }

    // --- Movimentações de Inventário ---
    match /inventory_movements/{imvId} {
      allow get:    if belongsToMyShop(resource.data);
      allow list:   if isSignedIn() && authShopId() != null;
      allow create: if belongsToMyShop(request.resource.data);
      allow update: if false; // Imutável por design (trilha de auditoria)
      allow delete: if isAdmin();
    }

    // --- Categorias (globais, gerenciadas pela plataforma) ---
    match /categories/{catId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // DEFAULT DENY — Qualquer path não mapeado acima é negado.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
